# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your_secure_session_secret_key_here

# MySQL Database Configuration
# Default for XAMPP is user 'root' and empty password
# For standard MySQL Server, enter your MySQL root password
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=farmfusion_db
DB_PORT=3306
